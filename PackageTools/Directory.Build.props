<Project>
    <PropertyGroup>
        <Prefix>PackageTools</Prefix>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RollForward>major</RollForward>
        <Version>0.0.0-beta.0</Version>
        <PackageId>$(Prefix).$(MSBuildProjectName)</PackageId>
        <RootNamespace>$(Prefix).$(MSBuildProjectName)</RootNamespace>
        <Authors>Ben Hutchison</Authors>
        <Copyright>© 2026 $(Authors)</Copyright>
        <Company>$(Authors)</Company>
        <PackAsTool>true</PackAsTool>
        <AssemblyName>$(Prefix).$(MSBuildProjectName)</AssemblyName>
        <ToolCommandName>dotnet-$(MSBuildProjectName.ToLowerInvariant())</ToolCommandName>
        <PackageOutputPath>$(MSBuildThisFileDirectory)\bin</PackageOutputPath>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <PackageProjectUrl>https://github.com/Aldaviva/DependencyHierarchy</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Aldaviva/DependencyHierarchy.git</RepositoryUrl>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <Description>Improved version of `dotnet $(MSBuildProjectName.ToLowerInvariant())`</Description>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <NoWarn>$(NoWarn);NU1507</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Common\Common.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <Using Include="$(Prefix).Common;$(RootNamespace);Unfucked;NuGetGalleryClient;System.Diagnostics;McMaster.Extensions.CommandLineUtils" />
    </ItemGroup>
    
    <PropertyGroup Condition="'$(CI)' == 'true' or '$(Configuration)' != 'Debug'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>