<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <AssemblyTitle>Workspace Resolution</AssemblyTitle>
        <Authors>Ben Hutchison</Authors>
        <Copyright>© 2026 $(Authors)</Copyright>
        <Company>$(Authors)</Company>
        <Version>1.0.5</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RollForward>latestMajor</RollForward>
        <SelfContained>false</SelfContained>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <DebugType>embedded</DebugType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>ben.ico</ApplicationIcon>
        <WarningsAsErrors>CA1859</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="ben.ico" />
        <AdditionalFiles Include="ExceptionAdjustments.txt" />
        <EmbeddedResource Include="Data\WorkspaceResolution.props" LogicalName="WorkspaceResolution.props" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="envdte" Version="17.14.40260" />
        <PackageReference Include="Gapotchenko.FX.Diagnostics.Process" Version="2026.8.3" />
        <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Dependencies\Dependencies.csproj" />
        <ProjectReference Include="..\NuGetGalleryClient\NuGetGalleryClient.csproj" />
    </ItemGroup>

</Project>